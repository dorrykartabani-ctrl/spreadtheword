<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Rewards & Progress</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="badges-config.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
  <link rel="stylesheet" href="nav.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { 'surface': '#f8fafc', 'card': '#ffffff', 'text-main': '#0f172a', 'text-muted': '#64748b', 'primary': '#3d6285', 'gold': '#D4A24C' }
        }
      }
    }
  </script>

  <style>
    body { font-family: 'Manrope', sans-serif; background: #f8fafc; color: #0f172a; }
    .font-headline { font-family: 'Plus Jakarta Sans', sans-serif; }
    .dash-card { background: white; border-radius: 24px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #f1f5f9; }
    
    /* Bottom Sheet Modal */
    .modal-overlay { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 100; }
    .modal-sheet { transform: translateY(100%); transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1); background: white; border-radius: 32px 32px 0 0; max-height: 90vh; overflow-y: auto; }
    .modal-sheet.open { transform: translateY(0); }

    /* Hide scrollbar for horizontal scroll */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .fade-up { opacity: 0; transform: translateY(10px); transition: 0.5s ease-out; }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
  </style>
</head>
<body class="pb-32">

<!-- HEADER -->
<header class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
  <div class="max-w-[430px] mx-auto px-6 py-4 flex items-center justify-between">
    <div>
      <h1 class="font-headline font-extrabold text-xl text-slate-900">Rewards</h1>
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Your Journey & Progress</p>
    </div>
    <a href="impact.html" class="text-[11px] font-bold text-primary bg-primary/10 px-3 py-1.5 rounded-full">Back to Impact</a>
  </div>
</header>

<main class="pt-24 px-5 max-w-[430px] mx-auto space-y-8">

  <!-- 1. YOUR COVENANT (SUBSCRIPTION) -->
  <section class="fade-up">
    <h3 class="font-headline font-bold text-lg mb-3 px-1">Your Covenant</h3>
    <div id="covenantCard" class="dash-card !p-6 bg-gradient-to-br from-slate-900 to-slate-800 text-white relative overflow-hidden cursor-pointer active:scale-[0.98] transition-transform" onclick="openCovenantModal()">
      <div class="absolute top-0 right-0 w-32 h-32 bg-gold/20 rounded-full blur-3xl"></div>
      <div class="relative z-10 flex items-center gap-4">
        <div id="covenantIconWrap" class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center border border-white/10">
          <img id="covenantImg" src="" class="w-10 h-10 object-contain">
        </div>
        <div>
          <p class="text-[9px] font-black text-gold uppercase tracking-widest mb-1">Current Status</p>
          <h2 id="covenantName" class="font-headline font-black text-xl">Loading...</h2>
          <p id="covenantTagline" class="text-[11px] text-white/60 mt-1">—</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. YOUR BADGES -->
  <section class="fade-up">
    <div class="flex justify-between items-center mb-3 px-1">
      <h3 class="font-headline font-bold text-lg">Your Badges</h3>
    </div>
    <div id="badgesContainer" class="dash-card !p-5">
      <!-- Injected via JS -->
    </div>
  </section>

  <!-- 3. YOUR TROPHIES -->
  <section class="fade-up">
    <div class="flex justify-between items-center mb-3 px-1">
      <h3 class="font-headline font-bold text-lg">Your Trophies</h3>
    </div>
    <div id="trophiesGrid" class="grid grid-cols-2 gap-3">
      <!-- Injected via JS -->
    </div>
    <button onclick="openUnclaimedModal()" class="w-full mt-4 py-3 text-sm font-bold text-primary bg-primary/5 rounded-xl active:scale-95 transition-transform">
      Discover unclaimed trophies →
    </button>
  </section>

  <!-- 4. CURRENT CALLS (CAMPAIGNS) -->
  <section class="fade-up">
    <div class="flex justify-between items-center mb-3 px-1">
      <h3 class="font-headline font-bold text-lg">Current Calls</h3>
    </div>
    <div id="campaignsList" class="space-y-3">
      <!-- Injected via JS -->
    </div>
  </section>

</main>

<!-- BOTTOM NAV -->
<nav class="fixed bottom-0 inset-x-0 z-40 bg-white/80 backdrop-blur-[20px] border-t border-slate-100" style="padding-bottom: env(safe-area-inset-bottom);">
  <div class="max-w-lg mx-auto flex items-center justify-around h-16 px-2">
    <a href="index.html" class="flex flex-col items-center gap-0.5 py-1.5 px-3 text-slate-400"><span class="material-symbols-outlined" style="font-size:1.35rem">home</span><span class="text-[10px] font-bold">Home</span></a>
    <a href="library.html" class="flex flex-col items-center gap-0.5 py-1.5 px-3 text-slate-400"><span class="material-symbols-outlined" style="font-size:1.35rem">auto_stories</span><span class="text-[10px] font-bold">Library</span></a>
    <a href="cause.html" class="flex flex-col items-center gap-0.5 py-1.5 px-3 text-slate-400"><span class="material-symbols-outlined" style="font-size:1.35rem">volunteer_activism</span><span class="text-[10px] font-bold">Missions</span></a>
    <a href="impact.html" class="flex flex-col items-center gap-0.5 py-1.5 px-3 text-slate-400"><span class="material-symbols-outlined" style="font-size:1.35rem">bar_chart</span><span class="text-[10px] font-bold">Impact</span></a>
    <a href="profile.html" class="flex flex-col items-center gap-0.5 py-1.5 px-3 text-slate-400"><span class="material-symbols-outlined" style="font-size:1.35rem">person</span><span class="text-[10px] font-bold">Profile</span></a>
  </div>
</nav>

<!-- UNIVERSAL MODAL CONTAINER -->
<div id="modalOverlay" class="fixed inset-0 modal-overlay hidden" onclick="closeModal()">
  <div id="modalSheet" class="absolute bottom-0 inset-x-0 modal-sheet p-8 max-w-lg mx-auto" onclick="event.stopPropagation()">
    <div class="w-12 h-1 bg-slate-200 mx-auto mb-8 rounded-full"></div>
    <div id="modalContent"></div>
    <button onclick="closeModal()" class="w-full mt-8 py-4 bg-slate-900 text-white font-headline font-bold rounded-2xl active:scale-95 transition-transform">Close</button>
  </div>
</div>

<script>
var supabaseClient = supabase.createClient(
  'https://nhymadutuhpjgkiurify.supabase.co',
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5oeW1hZHV0dWhwamdraXVyaWZ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5OTI5NzgsImV4cCI6MjA5NTU2ODk3OH0.kC5Ytuoi8Sy97ZTSZ8lEWeH1rngcbeHSxobOMIQahkM'
);

var currentUser, userProfile;
var userStats = { shares: 0, recruits_paid: 0, countries_paid: 0 };

// MOCK DATA FOR CAMPAIGNS & BADGES (Replace with Supabase calls later)
const MOCK_CAMPAIGNS = [
  { id: 'c1', title: '7 Days of Witness', desc: 'Share the Word on 7 separate days this week.', progress: 3, target: 7, reward: 'Faithful Witness Badge', cta: 'View Mission' },
  { id: 'c2', title: 'Nations Challenge', desc: 'Invite paid warriors from 3 new countries.', progress: 1, target: 3, reward: 'Nations Builder Badge + Voyager Progress', cta: 'Invite Warriors' }
];
const MOCK_BADGES = [
  { id: 'b1', name: 'Founding Member', desc: 'Joined during the initial launch phase.', date: 'Jan 2024', icon: 'rocket_launch' },
  { id: 'b2', name: 'First Mission', desc: 'Completed your very first mission deployment.', date: 'Feb 2024', icon: 'flag' }
];

async function init() {
  const s = await supabaseClient.auth.getSession();
  if (!s.data.session) { window.location.href = 'login.html'; return; }
  currentUser = s.data.session.user;
  await loadData();
  document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible'));
}

async function loadData() {
  const { data: profile } = await supabaseClient.from('profiles').select('*').eq('id', currentUser.id).single();
  userProfile = profile || {};

  const res = await Promise.allSettled([
    supabaseClient.from('shares').select('shared_at', { count: 'exact' }).eq('user_id', currentUser.id),
    supabaseClient.from('profiles').select('country, subscription_tier').eq('referred_by', userProfile.invite_code),
    supabaseClient.from('trophy_definitions').select('*').eq('is_active', true)
  ]);

  const sharesCount = res[0].value?.count || 0;
  const recruits = res[1].value?.data || [];
  const trophyDefs = res[2].value?.data || [];

  const paidRecruits = recruits.filter(r => r.subscription_tier !== 'free');
  userStats = { 
    shares: sharesCount, 
    recruits_paid: paidRecruits.length, 
    countries_paid: new Set(paidRecruits.map(r => r.country).filter(c => c)).size 
  };

  renderCovenant();
  renderBadges();
  renderTrophies(trophyDefs);
  renderCampaigns();
}

// --- RENDER FUNCTIONS ---

function renderCovenant() {
  const tier = (userProfile.subscription_tier || 'free').toLowerCase();
  const badge = SUBSCRIPTION_ROADMAP.find(b => b.key === tier) || SUBSCRIPTION_ROADMAP[0];
  
  document.getElementById('covenantImg').src = badge.image;
  document.getElementById('covenantName').textContent = badge.name;
  document.getElementById('covenantTagline').textContent = badge.tagline;
}

function renderBadges() {
  const container = document.getElementById('badgesContainer');
  const earnedBadges = [];

  // 1. Check if the user has been awarded the Genesis badge by Admin
  if (userProfile.badges && userProfile.badges.includes('genesis')) {
    earnedBadges.push({
      id: 'genesis',
      name: 'Genesis',
      desc: 'One of the first 5 warriors to join the movement and test the app.',
      date: 'Genesis Launch',
      icon: 'rocket_launch'
    });
  }

  // 2. Render the Badges
  if (earnedBadges.length === 0) {
    container.innerHTML = `<p class="text-center text-slate-400 text-sm py-4">Join a campaign or be a founding member to earn your first badge.</p>`;
    return;
  }

  container.innerHTML = `<div class="flex gap-4 overflow-x-auto no-scrollbar pb-2">
    ${earnedBadges.map(b => `
      <div class="flex-shrink-0 w-24 text-center cursor-pointer" onclick="openBadgeModal('${b.id}')">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-primary/20 to-gold/20 flex items-center justify-center mb-2 border border-gold/20">
          <span class="material-symbols-outlined text-gold text-2xl filled">${b.icon}</span>
        </div>
        <p class="text-[10px] font-bold text-slate-700 leading-tight">${b.name}</p>
      </div>
    `).join('')}
  </div>`;
}

function renderTrophies(trophyDefs) {
  const container = document.getElementById('trophiesGrid');
  container.innerHTML = '';
  
  const earnedTrophies = trophyDefs.filter(t => {
    const state = getTrophyState(t, userStats);
    return state.count > 0; // ONLY SHOW IF EARNED AT LEAST LEVEL 1
  });

  if (earnedTrophies.length === 0) {
    container.innerHTML = `<div class="col-span-2 text-center py-8 text-slate-400 text-sm">Start sharing or recruiting to unlock your first trophy.</div>`;
    return;
  }

  earnedTrophies.forEach(trophy => {
    const state = getTrophyState(trophy, userStats);
    const colors = RARITY_COLORS[state.activeTier.rarity];
    
    const div = document.createElement('div');
    div.className = 'dash-card !p-4 text-center cursor-pointer active:scale-95 transition-transform';
    div.onclick = () => openTrophyModal(trophy, state);
    div.innerHTML = `
      <div class="w-12 h-12 mx-auto rounded-xl ${colors.bg} flex items-center justify-center mb-2 shadow-sm">
        <span class="material-symbols-outlined text-white text-2xl filled">${trophy.icon}</span>
      </div>
      <p class="text-[11px] font-bold text-slate-800 leading-tight">${trophy.title}</p>
      <p class="text-[9px] font-black uppercase tracking-widest mt-1 ${colors.text}">${state.activeTier.rarity}</p>
    `;
    container.appendChild(div);
  });
}

function renderCampaigns() {
  const container = document.getElementById('campaignsList');
  container.innerHTML = MOCK_CAMPAIGNS.map(c => `
    <div class="dash-card !p-5 cursor-pointer active:scale-[0.98] transition-transform" onclick="openCampaignModal('${c.id}')">
      <div class="flex justify-between items-start mb-3">
        <div class="flex-1">
          <h4 class="font-headline font-bold text-slate-900">${c.title}</h4>
          <p class="text-[11px] text-slate-500 mt-1">${c.desc}</p>
        </div>
        <span class="material-symbols-outlined text-primary ml-3">arrow_forward</span>
      </div>
      <div class="flex items-center justify-between text-[10px] font-bold text-slate-400 mb-1.5">
        <span>Progress</span>
        <span>${c.progress} / ${c.target}</span>
      </div>
      <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden mb-3">
        <div class="h-full bg-primary rounded-full" style="width: ${(c.progress/c.target)*100}%"></div>
      </div>
      <p class="text-[10px] text-gold font-bold">Reward: ${c.reward}</p>
    </div>
  `).join('');
}

// --- MODAL LOGIC ---

function openModal(html) {
  document.getElementById('modalContent').innerHTML = html;
  document.getElementById('modalOverlay').classList.remove('hidden');
  setTimeout(() => document.getElementById('modalSheet').classList.add('open'), 10);
}

function closeModal() {
  document.getElementById('modalSheet').classList.remove('open');
  setTimeout(() => document.getElementById('modalOverlay').classList.add('hidden'), 400);
}

function openCovenantModal() {
  const currentTier = (userProfile.subscription_tier || 'free').toLowerCase();
  const html = `
    <div class="text-center mb-6">
      <h2 class="font-headline font-black text-2xl text-slate-900">The Covenant Path</h2>
      <p class="text-sm text-slate-500 mt-2">Your commitment level determines your access and impact.</p>
    </div>
    <div class="space-y-3">
      ${SUBSCRIPTION_ROADMAP.map(b => {
        const isActive = b.key === currentTier;
        return `
        <div class="flex items-center gap-4 p-4 rounded-2xl border ${isActive ? 'border-primary bg-primary/5' : 'border-slate-100 bg-slate-50'}">
          <img src="${b.image}" class="w-10 h-10 object-contain ${isActive ? '' : 'grayscale opacity-50'}">
          <div class="flex-1">
            <p class="font-headline font-bold text-sm ${isActive ? 'text-primary' : 'text-slate-700'}">${b.name}</p>
            <p class="text-[10px] text-slate-400">${b.tagline}</p>
          </div>
          <p class="text-[10px] font-bold ${isActive ? 'text-primary' : 'text-slate-400'}">${b.price}</p>
        </div>`;
      }).join('')}
    </div>
  `;
  openModal(html);
}

function openTrophyModal(trophy, state) {
  const html = `
    <div class="text-center mb-6">
      <div class="w-20 h-20 mx-auto rounded-2xl ${RARITY_COLORS[state.activeTier.rarity].bg} flex items-center justify-center mb-4 shadow-lg">
        <span class="material-symbols-outlined text-white text-4xl filled">${trophy.icon}</span>
      </div>
      <h2 class="font-headline font-black text-2xl text-slate-900">${trophy.title}</h2>
      <p class="text-sm text-slate-500 mt-2 px-4">${trophy.description}</p>
    </div>
    <div class="space-y-3">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest text-center mb-2">Roadmap to Mastery</p>
      ${trophy.tiers.map(tier => {
        const isDone = state.count >= tier.req;
        const isNext = !isDone && state.nextTier && state.nextTier.req === tier.req;
        return `
        <div class="flex items-center gap-3 p-3 rounded-xl ${isDone ? 'bg-slate-50 border border-slate-100' : isNext ? 'bg-primary/5 border border-primary/20' : 'opacity-40'}">
          <div class="w-2.5 h-2.5 rounded-full ${RARITY_COLORS[tier.rarity].bg}"></div>
          <div class="flex-1">
            <p class="text-xs font-bold text-slate-800">${tier.name}</p>
            <p class="text-[10px] text-slate-400">${tier.desc || ''}</p>
          </div>
          <p class="text-[10px] font-black ${isDone ? 'text-primary' : 'text-slate-400'}">${tier.req} ${trophy.type.split('_')[0].toUpperCase()}</p>
          ${isDone ? '<span class="material-symbols-outlined text-green-500 text-lg filled">check_circle</span>' : ''}
        </div>`;
      }).join('')}
    </div>
  `;
  openModal(html);
}

function openBadgeModal(id) {
  const badge = MOCK_BADGES.find(b => b.id === id);
  openModal(`
    <div class="text-center">
      <div class="w-20 h-20 mx-auto rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-primary text-4xl">${badge.icon}</span>
      </div>
      <h2 class="font-headline font-black text-2xl text-slate-900">${badge.name}</h2>
      <p class="text-sm text-slate-500 mt-3 px-6">${badge.desc}</p>
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-6">Earned ${badge.date}</p>
    </div>
  `);
}

function openCampaignModal(id) {
  const c = MOCK_CAMPAIGNS.find(x => x.id === id);
  openModal(`
    <div class="text-center mb-6">
      <h2 class="font-headline font-black text-2xl text-slate-900">${c.title}</h2>
      <p class="text-sm text-slate-500 mt-3 px-4">${c.desc}</p>
    </div>
    <div class="bg-slate-50 p-5 rounded-2xl mb-6">
      <div class="flex justify-between text-xs font-bold text-slate-600 mb-2"><span>Your Progress</span><span>${c.progress} / ${c.target}</span></div>
      <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden"><div class="h-full bg-primary rounded-full" style="width: ${(c.progress/c.target)*100}%"></div></div>
      <p class="text-[10px] text-gold font-bold mt-4 text-center">Reward: ${c.reward}</p>
    </div>
    <a href="cause.html" class="block w-full py-4 bg-slate-900 text-white font-headline font-bold rounded-2xl text-center active:scale-95 transition-transform">${c.cta}</a>
  `);
}

function openUnclaimedModal() {
  // In a real app, fetch all trophies and filter out the earned ones
  openModal(`<div class="text-center py-10"><p class="text-slate-500">Full list of unclaimed trophies will appear here.</p></div>`);
}

init();
</script>
</body>
</html>
